<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">
 <display-name>Citas EsSalud</display-name>
 <session-config><session-timeout>30</session-timeout><tracking-mode>COOKIE</tracking-mode></session-config>
 <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
 <error-page><error-code>403</error-code><location>/WEB-INF/vistas/ErrorView.jsp</location></error-page>
 <error-page><error-code>404</error-code><location>/WEB-INF/vistas/ErrorView.jsp</location></error-page>
 <error-page><error-code>500</error-code><location>/WEB-INF/vistas/ErrorView.jsp</location></error-page>
 <error-page><error-code>503</error-code><location>/WEB-INF/vistas/ErrorView.jsp</location></error-page>
 <error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/vistas/ErrorView.jsp</location></error-page>
 <resource-ref><res-ref-name>jdbc/EsSaludCitas</res-ref-name><res-type>javax.sql.DataSource</res-type><res-auth>Container</res-auth></resource-ref>
</web-app>
