<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@include file="partials/Cabecera.jspf"%>
<% Map<String,Object> constancia=(Map<String,Object>)request.getAttribute("constancia");List<Map<String,Object>> detalle=(List<Map<String,Object>>)constancia.get("detalle"); %>
<div class="encabezado-pagina"><div><span class="sobre-titulo">SOLICITUD REGISTRADA</span><h1>Constancia de citas</h1><p>Consulta los datos y el estado actual de tus atenciones.</p></div><button type="button" class="btn btn-primary" data-imprimir>Imprimir o guardar PDF</button></div>
<article class="panel constancia"><div class="constancia-marca"><span class="marca-icono">✚</span><div><strong>Citas EsSalud</strong><p>Constancia de solicitud</p></div></div><div class="row g-3 constancia-datos"><div class="col-md-4"><small>Solicitud</small><strong><%=WebView.e(constancia.get("codigo"))%></strong></div><div class="col-md-4"><small>Paciente</small><strong><%=WebView.e(constancia.get("paciente"))%></strong></div><div class="col-md-4"><small>Fecha de registro</small><strong><%=WebView.e(constancia.get("fechaSolicitud"))%></strong></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Cita</th><th>Especialidad</th><th>Profesional</th><th>Establecimiento</th><th>Inicio</th><th>Estado</th></tr></thead><tbody><% for(Map<String,Object> c:detalle){ %><tr><td><%=WebView.e(c.get("codigo"))%></td><td><%=WebView.e(c.get("especialidad"))%></td><td><%=WebView.e(c.get("medico"))%></td><td><%=WebView.e(c.get("establecimiento"))%></td><td><%=WebView.e(c.get("inicio"))%></td><td><%=WebView.e(c.get("estado"))%></td></tr><% } %></tbody></table></div><p class="texto-ayuda">Verifica la fecha y el estado de la cita antes de tu atención. Si necesitas cambiarla, usa la opción Reprogramar en Citas médicas.</p></article><a class="btn btn-outline-primary mt-3 no-imprimir" href="<%=ctx%>/app/portal?modulo=citas">Volver a las citas</a><%@include file="partials/Pie.jspf"%>
