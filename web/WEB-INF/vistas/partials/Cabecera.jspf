<%@page pageEncoding="UTF-8" import="java.util.*,essalud.modelo.Usuario,essalud.menu.ComandoMenu,essalud.vista.WebView,essalud.servicio.SesionService"%>
<% Usuario actual=(Usuario)request.getAttribute("usuario");String ctx=request.getContextPath();String modulo=(String)request.getAttribute("modulo");List<ComandoMenu> menu=(List<ComandoMenu>)request.getAttribute("menu");if(menu==null)menu=Collections.emptyList(); %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=WebView.e(WebView.etiqueta(modulo==null?"Portal":modulo))%> · Citas EsSalud</title><link rel="stylesheet" href="<%=ctx%>/assets/bootstrap.min.css"><link rel="stylesheet" href="<%=ctx%>/assets/portal.css"><script src="<%=ctx%>/assets/portal.js" defer></script></head><body>
<div class="portal-layout"><aside class="barra-lateral"><a class="marca marca-sidebar" href="<%=ctx%>/app/portal"><span class="marca-icono">✚</span><span>Citas <strong>EsSalud</strong><small>GESTIÓN DE ATENCIONES</small></span></a><p class="nav-titulo">MI PORTAL</p><nav aria-label="Menú principal"><% for(ComandoMenu opcion:menu){ %><a class="nav-opcion <%=opcion.getCodigo().equals(modulo)?"seleccionada":""%>" href="<%=ctx%>/app/portal?modulo=<%=WebView.e(opcion.getCodigo())%>"><%=WebView.e(opcion.getTitulo())%><span aria-hidden="true">›</span></a><% } %></nav><div class="lateral-pie"><span class="punto"></span> Portal de citas médicas</div></aside>
<div class="portal-contenido"><header class="portal-cabecera"><button type="button" class="btn btn-outline-secondary menu-movil" data-menu aria-label="Mostrar menú">☰</button><span class="ruta-pagina">Mi portal <span>/</span> <%=WebView.e(WebView.etiqueta(modulo==null?"Inicio":modulo))%></span><div class="sesion-cabecera"><% if(actual!=null){ %><span><strong><%=WebView.e(actual.getNombre())%></strong><small><%=WebView.e(actual.getRol())%></small></span><form action="<%=ctx%>/salir" method="post"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><button class="btn btn-outline-primary btn-sm" type="submit">Cerrar sesión</button></form><% } %></div></header><main class="contenido-principal">
<% Object flashError=session.getAttribute("error"),flashExito=session.getAttribute("exito");session.removeAttribute("error");session.removeAttribute("exito");if(flashError!=null){ %><div class="alert alert-danger" role="alert"><%=WebView.e(flashError)%></div><% } if(flashExito!=null){ %><div class="alert alert-success" role="status"><%=WebView.e(flashExito)%></div><% } %>
