<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@include file="partials/Cabecera.jspf"%>
<section class="bienvenida"><div><span class="sobre-titulo">TU ATENCIÓN, MEJOR ORGANIZADA</span><h1>Hola, <%=WebView.e(actual.getNombre().split(" ")[0])%>.</h1><p>Bienvenido a tu espacio de gestión de citas médicas.</p><span class="perfil-etiqueta"><%=WebView.e(actual.getRol())%></span></div><div class="bienvenida-signo" aria-hidden="true">✚</div></section>
<div class="row g-4 mt-1"><div class="col-md-4"><section class="panel tarjeta-indicador"><span>Citas reservadas</span><strong><%=WebView.e(request.getAttribute("reservadas"))%></strong><small>Según las citas visibles para tu perfil</small></section></div><div class="col-md-4"><section class="panel tarjeta-indicador"><span>Opciones disponibles</span><strong><%=menu.size()%></strong><small>Accesos asignados a tu rol</small></section></div><div class="col-md-4"><section class="panel tarjeta-indicador"><span>Tu cuenta</span><strong class="estado-cuenta">Activa</strong><small><%=WebView.e(actual.getNombreUsuario())%></small></section></div></div>
<section class="panel mt-4"><div class="panel-titulo"><div><span class="sobre-titulo">CONTINÚA DESDE AQUÍ</span><h2>¿Qué necesitas hacer?</h2></div></div><div class="accesos-grid"><% for(ComandoMenu opcion:menu){if(opcion.getCodigo().equals("inicio"))continue; %><a class="acceso-tarjeta" href="<%=ctx%>/app/portal?modulo=<%=WebView.e(opcion.getCodigo())%>"><strong><%=WebView.e(opcion.getTitulo())%></strong><span>Ingresar <span aria-hidden="true">→</span></span></a><% } %></div></section>
<%@include file="partials/Pie.jspf"%>
