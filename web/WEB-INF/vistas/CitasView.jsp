<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="java.sql.Timestamp,java.time.LocalDateTime"%><%@include file="partials/Cabecera.jspf"%>
<% List<Map<String,Object>> citas=(List<Map<String,Object>>)request.getAttribute("citas"),cupos=(List<Map<String,Object>>)request.getAttribute("cupos");Map<String,List<Map<String,Object>>> opciones=(Map<String,List<Map<String,Object>>>)request.getAttribute("opciones");boolean esMedico=actual.getRolId()==3; %>
<div class="encabezado-pagina"><div><span class="sobre-titulo">ORGANIZA TU ATENCIÓN</span><h1><%=esMedico?"Mi agenda":"Citas médicas"%></h1><p><%=esMedico?"Consulta tus citas y registra las atenciones realizadas.":"Busca un cupo, registra tu solicitud y consulta el estado de tus citas."%></p></div><% if(!esMedico){ %><a class="btn btn-primary" href="#agendar-cita">+ Agendar cita</a><% } %></div>
<% if(!esMedico){ %><section class="panel mb-4" id="agendar-cita"><div class="panel-titulo"><h2>Agendar cita</h2><span class="contador">Elige un horario</span></div><form action="<%=ctx%>/app/portal" method="get" class="row g-3 mb-4"><input type="hidden" name="modulo" value="citas"><div class="col-md-4"><label class="form-label" for="especialidad">Especialidad</label><select class="form-select" id="especialidad" name="especialidad"><option value="">Todas las especialidades</option><% for(Map<String,Object> o:opciones.get("especialidades")){ %><option value="<%=WebView.e(o.get("id"))%>" <%=String.valueOf(o.get("id")).equals(request.getParameter("especialidad"))?"selected":""%>><%=WebView.e(o.get("nombre"))%></option><% } %></select></div><div class="col-md-4"><label class="form-label" for="medico">Médico</label><select class="form-select" id="medico" name="medico"><option value="">Todos los médicos</option><% for(Map<String,Object> o:opciones.get("medicos")){ %><option value="<%=WebView.e(o.get("id"))%>" <%=String.valueOf(o.get("id")).equals(request.getParameter("medico"))?"selected":""%>><%=WebView.e(o.get("nombre"))%></option><% } %></select></div><div class="col-md-3"><label class="form-label" for="fecha">Fecha</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%=WebView.e(request.getParameter("fecha"))%>"></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Buscar</button></div></form>
<form action="<%=ctx%>/app/citas" method="post"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="accion" value="reservar"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Elegir</th><th>Especialidad</th><th>Médico</th><th>Establecimiento</th><th>Inicio</th><th>Fin</th></tr></thead><tbody><% if(cupos.isEmpty()){ %><tr><td colspan="6" class="vacio">No hay cupos disponibles con estos filtros. Prueba otra fecha o consulta con el operador.</td></tr><% } for(Map<String,Object> h:cupos){ %><tr><td><input class="form-check-input" type="checkbox" name="horarios" value="<%=WebView.e(h.get("idHorario"))%>" aria-label="Seleccionar horario <%=WebView.e(h.get("idHorario"))%>"></td><td><%=WebView.e(h.get("especialidad"))%></td><td><%=WebView.e(h.get("medico"))%></td><td><%=WebView.e(h.get("establecimiento"))%></td><td><%=WebView.e(h.get("inicio"))%></td><td><%=WebView.e(h.get("fin"))%></td></tr><% } %></tbody></table></div>
<% if(cupos.isEmpty()){ %>
<div class="alert alert-light border mt-3"><strong>No hay horarios disponibles para agendar.</strong>
<% if(actual.getRolId()==1){ %> Registra un horario futuro y vuelve a esta sección. <a class="btn btn-sm btn-outline-primary ms-2" href="<%=ctx%>/app/portal?modulo=horarios#formulario">+ Crear horario</a>
<% }else{ %> Prueba otros filtros o pide al administrador que registre nuevos horarios.<% } %></div>
<% } %>
<fieldset <%=cupos.isEmpty()?"disabled":""%>><legend class="visually-hidden">Datos para agendar la cita</legend>
<div class="row g-3 mt-1">
<% if(actual.getRolId()!=4){ %><div class="col-md-5"><label class="form-label" for="idPaciente">Paciente</label><select class="form-select" id="idPaciente" name="idPaciente" required><option value="">Seleccionar paciente</option><% for(Map<String,Object> p:opciones.get("pacientes")){ %><option value="<%=WebView.e(p.get("id"))%>"><%=WebView.e(p.get("nombre"))%></option><% } %></select><% if(actual.getRolId()==1){ %><a class="texto-ayuda" href="<%=ctx%>/app/portal?modulo=pacientes#formulario">Registrar un paciente</a><% } %></div><% } %>
<div class="col-md-7"><label class="form-label" for="motivo">Motivo de la consulta</label><input class="form-control" name="motivo" id="motivo" maxlength="200" required placeholder="Ejemplo: consulta de control"></div></div>
<div class="reserva-pie"><p>Marca de uno a tres horarios, completa el motivo y confirma tu cita.</p><button class="btn btn-primary" type="submit" <%=cupos.isEmpty()?"disabled":""%>>Agendar cita y generar constancia</button></div>
</fieldset></form></section><% } %>
<section class="panel" id="mis-citas"><div class="panel-titulo"><h2><%=esMedico?"Citas de mi agenda":"Mis citas y solicitudes"%></h2><span class="contador"><%=citas.size()%> citas</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Código</th><th>Paciente</th><th>Atención</th><th>Fecha y hora</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% if(citas.isEmpty()){ %><tr><td colspan="6" class="vacio">Todavía no hay citas para mostrar.</td></tr><% } for(Map<String,Object> c:citas){boolean reservada=c.get("estado").equals("RESERVADA");boolean futura=((Timestamp)c.get("inicio")).toLocalDateTime().isAfter(LocalDateTime.now()); %><tr><td><strong><%=WebView.e(c.get("codigo"))%></strong></td><td><%=WebView.e(c.get("paciente"))%></td><td><%=WebView.e(c.get("especialidad"))%><small class="dato-secundario"><%=WebView.e(c.get("medico"))%><br><%=WebView.e(c.get("establecimiento"))%></small></td><td><%=WebView.e(c.get("inicio"))%></td><td><span class="badge <%=reservada?"text-bg-success":"text-bg-light"%>"><%=WebView.e(c.get("estado"))%></span></td><td><div class="acciones-cita"><a class="btn btn-sm btn-outline-primary" href="<%=ctx%>/app/portal?modulo=constancia&amp;id=<%=WebView.e(c.get("idSolicitud"))%>">Constancia</a>
<% if(reservada&&futura&&!esMedico){ %><form action="<%=ctx%>/app/citas" method="post" data-confirmar="¿Cancelar esta cita y liberar el cupo?"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="accion" value="cancelar"><input type="hidden" name="idCita" value="<%=WebView.e(c.get("idCita"))%>"><button class="btn btn-sm btn-outline-danger" type="submit">Cancelar</button></form><% if(!cupos.isEmpty()){ %><details><summary>Reprogramar</summary><form action="<%=ctx%>/app/citas" method="post" class="reprogramar-form"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="accion" value="reprogramar"><input type="hidden" name="idCita" value="<%=WebView.e(c.get("idCita"))%>"><label class="form-label" for="cupo-<%=WebView.e(c.get("idCita"))%>">Nuevo horario</label><select class="form-select form-select-sm" id="cupo-<%=WebView.e(c.get("idCita"))%>" name="idHorario" required><option value="">Seleccionar</option><% for(Map<String,Object> h:cupos){ %><option value="<%=WebView.e(h.get("idHorario"))%>"><%=WebView.e(h.get("inicio"))%> · <%=WebView.e(h.get("especialidad"))%> · <%=WebView.e(h.get("medico"))%></option><% } %></select><button class="btn btn-primary btn-sm mt-2" type="submit">Confirmar cambio</button></form></details><% } } %>
<% if(reservada&&!futura&&(esMedico||actual.getRolId()==1)){ %><form action="<%=ctx%>/app/citas" method="post"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="accion" value="atender"><input type="hidden" name="idCita" value="<%=WebView.e(c.get("idCita"))%>"><button class="btn btn-sm btn-primary" type="submit">Marcar atendida</button></form><% } %></div></td></tr><% } %></tbody></table></div></section>
<% List<Map<String,Object>> recordatorios=(List<Map<String,Object>>)request.getAttribute("recordatorios");if(!recordatorios.isEmpty()){ %><section class="panel mt-4"><h2>Recordatorios en tu portal</h2><ul class="recordatorios"><% for(Map<String,Object> r:recordatorios){ %><li><%=WebView.e(r.get("mensaje"))%></li><% } %></ul></section><% } %><%@include file="partials/Pie.jspf"%>
