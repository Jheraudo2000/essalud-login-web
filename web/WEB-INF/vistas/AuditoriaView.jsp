<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@include file="partials/Cabecera.jspf"%>
<div class="encabezado-pagina"><div><span class="sobre-titulo">SEGURIDAD Y TRAZABILIDAD</span><h1>Auditoría</h1><p>Consulta las operaciones recientes y los intentos de acceso.</p></div></div>
<% String[] fuentes={"filas","accesos"};String[] titulos={"Últimas 300 operaciones","Últimos 100 intentos de acceso"};for(int i=0;i<fuentes.length;i++){List<Map<String,Object>> registros=(List<Map<String,Object>>)request.getAttribute(fuentes[i]); %><section class="panel mb-4"><h2><%=titulos[i]%></h2><div class="table-responsive"><table class="table align-middle"><thead><tr><% if(!registros.isEmpty())for(String k:registros.get(0).keySet()){ %><th><%=WebView.e(WebView.etiqueta(k))%></th><% } %></tr></thead><tbody><% if(registros.isEmpty()){ %><tr><td class="vacio">No hay eventos registrados.</td></tr><% } for(Map<String,Object> r:registros){ %><tr><% for(Object v:r.values()){ %><td><%=WebView.e(v)%></td><% } %></tr><% } %></tbody></table></div></section><% } %><%@include file="partials/Pie.jspf"%>
