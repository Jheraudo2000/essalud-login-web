<%@page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8"%><%@include file="partials/Cabecera.jspf"%>
<%!
private String campo(Map<String,Object> datos,String nombre,String etiqueta,String tipo,boolean obligatorio,int max) {
    String valor=tipo.equals("password")?"":WebView.e(datos.get(nombre));
    if(tipo.equals("datetime-local"))valor=WebView.e(WebView.fechaInput(datos.get(nombre)));
    return "<div class=\"mb-3\"><label class=\"form-label\" for=\"campo-"+nombre+"\">"+etiqueta+(obligatorio?" *":"")+"</label><input class=\"form-control\" id=\"campo-"+nombre+"\" name=\""+nombre+"\" type=\""+tipo+"\" maxlength=\""+max+"\" value=\""+valor+"\" "+(obligatorio?"required":"")+(tipo.equals("password")?" autocomplete=\"new-password\"":"")+"></div>";
}
private String combo(Map<String,Object> datos,String nombre,String etiqueta,List<Map<String,Object>> opciones,boolean obligatorio) {
    String valor=String.valueOf(datos.getOrDefault(nombre,""));
    StringBuilder html=new StringBuilder("<div class=\"mb-3\"><label class=\"form-label\" for=\"campo-"+nombre+"\">"+etiqueta+(obligatorio?" *":"")+"</label><select class=\"form-select\" id=\"campo-"+nombre+"\" name=\""+nombre+"\" "+(obligatorio?"required":"")+"><option value=\"\">Seleccionar</option>");
    for(Map<String,Object> o:opciones)html.append("<option value=\"").append(WebView.e(o.get("id"))).append("\" ").append(valor.equals(String.valueOf(o.get("id")))?"selected":"").append(">").append(WebView.e(o.get("nombre"))).append("</option>");
    return html.append("</select></div>").toString();
}
%>
<% Map<String,Object> ficha=(Map<String,Object>)request.getAttribute("ficha");Map<String,List<Map<String,Object>>> opciones=(Map<String,List<Map<String,Object>>>)request.getAttribute("opciones");List<Map<String,Object>> filas=(List<Map<String,Object>>)request.getAttribute("filas");int editando=Integer.parseInt(String.valueOf(ficha.get("id")));boolean perfil=modulo.equals("perfil");boolean persona=modulo.equals("usuarios")||modulo.equals("pacientes")||perfil;String titulo=perfil?"Mi perfil":WebView.etiqueta(modulo); %>
<div class="encabezado-pagina"><div><span class="sobre-titulo">GESTIÓN DE ATENCIONES</span><h1><%=WebView.e(titulo)%></h1><p><%=perfil?"Actualiza tu información de contacto.":"Consulta, registra y mantén la información de este módulo."%></p></div><% if(!perfil){ %><a class="btn btn-primary" href="<%=ctx%>/app/portal?modulo=<%=WebView.e(modulo)%>#formulario">+ Nuevo registro</a><% } %></div>
<div class="row g-4"><% if(!perfil){ %><div class="col-xxl-8"><section class="panel"><div class="panel-titulo"><h2>Registros</h2><span class="contador"><%=filas.size()%> registros</span></div><% if(modulo.equals("usuarios")){ %><form class="buscador" method="get" action="<%=ctx%>/app/portal"><input type="hidden" name="modulo" value="usuarios"><label class="visually-hidden" for="q">Buscar usuarios</label><input class="form-control" id="q" name="q" maxlength="80" placeholder="Buscar por usuario, nombre o DNI" value="<%=WebView.e(request.getParameter("q"))%>"><button class="btn btn-outline-primary">Buscar</button></form><% } %>
<div class="table-responsive"><table class="table align-middle"><thead><tr><% if(!filas.isEmpty())for(String columna:filas.get(0).keySet()){ %><th scope="col"><%=WebView.e(WebView.etiqueta(columna))%></th><% } %><th scope="col">Acciones</th></tr></thead><tbody><% if(filas.isEmpty()){ %><tr><td class="vacio">Todavía no hay registros. Puedes crear el primero.</td></tr><% } %>
<% for(Map<String,Object> fila:filas){Object id=fila.containsKey("idUsuario")?fila.get("idUsuario"):fila.get("id"); %><tr><% for(Map.Entry<String,Object> celda:fila.entrySet()){ %><td><% if(celda.getValue() instanceof Boolean){ %><span class="badge <%=Boolean.TRUE.equals(celda.getValue())?"text-bg-warning":"text-bg-light"%>"><%=Boolean.TRUE.equals(celda.getValue())?"Sí":"No"%></span><% } else { %><%=WebView.e(celda.getValue())%><% } %></td><% } %><td><div class="acciones-tabla"><a class="btn btn-sm btn-outline-primary" href="<%=ctx%>/app/portal?modulo=<%=WebView.e(modulo)%>&amp;id=<%=WebView.e(id)%>#formulario">Editar</a>
<% if(modulo.equals("pacientes")){ %><a class="btn btn-sm btn-outline-secondary" href="<%=ctx%>/app/portal?modulo=pacientes&amp;id=<%=WebView.e(id)%>&amp;accion=duplicar#formulario">Copiar contactos</a><% } %>
<% if(modulo.equals("usuarios")&&Boolean.TRUE.equals(fila.get("bloqueado"))){ %><form action="<%=ctx%>/app/guardar" method="post"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="modulo" value="usuarios"><input type="hidden" name="id" value="<%=WebView.e(id)%>"><input type="hidden" name="accion" value="desbloquear"><button class="btn btn-sm btn-outline-warning">Desbloquear</button></form><% } %>
<% if(!"Inactivo".equals(fila.get("estado"))){ %><form action="<%=ctx%>/app/guardar" method="post" data-confirmar="¿Dar de baja este registro? Se conservará su historial."><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="modulo" value="<%=WebView.e(modulo)%>"><input type="hidden" name="id" value="<%=WebView.e(id)%>"><input type="hidden" name="accion" value="eliminar"><button class="btn btn-sm btn-outline-danger">Dar de baja</button></form><% } %></div></td></tr><% } %></tbody></table></div></section></div><% } %>
<div class="<%=perfil?"col-lg-8":"col-xxl-4"%>"><section class="panel" id="formulario"><div class="panel-titulo"><h2><%=perfil?"Mis datos":editando>0?"Editar registro":"Nuevo registro"%></h2></div><form action="<%=ctx%>/app/guardar" method="post"><input type="hidden" name="csrf" value="<%=SesionService.csrf(session)%>"><input type="hidden" name="modulo" value="<%=WebView.e(modulo)%>"><input type="hidden" name="id" value="<%=editando%>"><input type="hidden" name="accion" value="guardar">
<% if(modulo.equals("usuarios")){ %><%=campo(ficha,"nombreUsuario","Usuario","text",true,50)%><%=combo(ficha,"rol_id","Rol",opciones.get("roles"),true)%><% } %>
<% if(persona){ %><%=campo(ficha,"nombres","Nombres","text",true,80)%><%=campo(ficha,"apellidos","Apellidos","text",true,80)%><%=campo(ficha,"dni","DNI","text",true,8)%><%=campo(ficha,"correo","Correo electrónico","email",false,80)%><%=campo(ficha,"telefono","Teléfono","tel",false,20)%>
<details class="datos-adicionales"><summary>Datos adicionales y dirección</summary><div class="pt-3"><%=combo(ficha,"idSexo","Sexo",opciones.get("sexos"),false)%><%=combo(ficha,"idEstadoCivil","Estado civil",opciones.get("civiles"),false)%><%=campo(ficha,"calleAvenida","Calle o avenida","text",false,150)%><%=campo(ficha,"numero","Número","text",false,10)%><%=combo(ficha,"idDistrito","Distrito",opciones.get("distritos"),false)%><%=campo(ficha,"referencia","Referencia","text",false,255)%></div></details><% } %>
<% if(modulo.equals("usuarios")||perfil){ if(perfil){ %><%=campo(ficha,"claveActual","Contraseña actual (para cambiarla)","password",false,128)%><% } %><%=campo(ficha,"clave",editando==0?"Contraseña":"Nueva contraseña (opcional)","password",editando==0,128)%><p class="texto-ayuda">Entre 10 y 128 caracteres. La contraseña guardada nunca se muestra.</p><% } %>
<% if(modulo.equals("pacientes")){ %><%=campo(ficha,"numeroSeguro","Número de seguro","text",true,30)%><% } %>
<% if(modulo.equals("medicos")){ %><%=combo(ficha,"idUsuario","Cuenta de médico",opciones.get("cuentasMedicas"),true)%><p class="texto-ayuda">La cuenta con rol Médico se registra primero en Usuarios.</p><%=campo(ficha,"cmp","CMP","text",true,15)%><%=combo(ficha,"idEspecialidad","Especialidad",opciones.get("especialidades"),true)%><%=combo(ficha,"idEstablecimiento","Establecimiento",opciones.get("establecimientos"),true)%><% } %>
<% if(modulo.equals("especialidades")||modulo.equals("establecimientos")){ %><%=campo(ficha,"nombre","Nombre","text",true,100)%><%=campo(ficha,modulo.equals("especialidades")?"descripcion":"direccion",modulo.equals("especialidades")?"Descripción":"Dirección","text",!modulo.equals("especialidades"),modulo.equals("especialidades")?255:180)%><% } %>
<% if(modulo.equals("horarios")){ %><%=combo(ficha,"idMedico","Médico",opciones.get("medicos"),true)%><%=campo(ficha,"inicio","Fecha y hora de inicio","datetime-local",true,30)%><%=campo(ficha,"fin","Fecha y hora de fin","datetime-local",true,30)%><% } %>
<% if(!perfil){ %><div class="mb-3"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado"><option value="Activo" <%=!"Inactivo".equals(ficha.get("estado"))?"selected":""%>>Activo</option><option value="Inactivo" <%= "Inactivo".equals(ficha.get("estado"))?"selected":""%>>Inactivo</option></select></div><% } %>
<button class="btn btn-primary w-100" type="submit"><%=perfil?"Guardar mis datos":"Guardar registro"%></button><% if(!perfil&&editando>0){ %><a class="btn btn-link w-100 mt-2" href="<%=ctx%>/app/portal?modulo=<%=WebView.e(modulo)%>">Cancelar edición</a><% } %><p class="texto-ayuda mt-3 mb-0">Los campos con * son obligatorios.</p></form></section></div></div><%@include file="partials/Pie.jspf"%>
